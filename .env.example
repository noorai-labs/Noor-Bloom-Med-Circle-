EXPO_PUBLIC_APP_MODE=demo
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=

# Use cloud mode only after configuring Clerk and deploying backend/wrangler.jsonc.
# Never put Clerk secrets or R2 access keys in EXPO_PUBLIC variables.

# Expo project identity (obtain from the maintainer).
# Explicitly export/load both into the shell before EAS commands; see docs/dev-expo-ci.md.
EXPO_OWNER=
EXPO_PROJECT_ID=
