{
  "expo": {
    "name": "BLOOM MED",
    "slug": "bloom-med",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/bloom-logo-v2.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.noorailabs.bloommed"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#147D68",
        "foregroundImage": "./assets/bloom-logo-v2.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.noorailabs.bloommed",
      "versionCode": 9
    },
    "web": {
      "favicon": "./assets/bloom-logo-v2.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F8FA",
          "image": "./assets/bloom-logo-v2.png",
          "imageWidth": 116,
          "resizeMode": "contain"
        }
      ],
      "@clerk/expo",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-font",
      "expo-notifications",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WebRTC 150 carries an unused custom-class-loader JNI bridge reference.\n# No blanket dontwarn: preserve R8 checks for every other missing class.\n-dontwarn livekit.org.jni_zero.JniZeroJni"
          }
        }
      ]
    ],
    "scheme": "bloommed",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1b8258b4-1911-4985-9e16-c82f99c01128"
      }
    },
    "owner": "dominateranc"
  }
}
